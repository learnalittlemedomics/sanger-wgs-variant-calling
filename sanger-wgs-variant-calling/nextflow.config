manifest {
    homePage = 'https://github.com/icgc-argo/sanger-wgs-variant-calling'
    description = 'ICGC ARGO Sanger WGS Variant Calling Workflow'
    nextflowVersion = '>=24.10.0'
}

docker {
    enabled = true
    runOptions = '-u \$(id -u):\$(id -g)'
}
includeConfig '../conf/sanger-split.config'
