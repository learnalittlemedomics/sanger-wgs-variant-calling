includeConfig '../../conf/sanger-scatter.config'
process.executor = 'slurm'
process.queue = 'mock'
process.container = null
docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
executor.queueSize = 1
executor.submitRateLimit = '100/1sec'
executor.retry.delay = '100 ms'
// Nextflow requires delay < maxDelay (strict inequality).
executor.retry.maxDelay = '1 sec'
executor.retry.jitter = 0
executor.retry.maxAttempts = 6
executor.pollInterval = '100 ms'
executor.queueStatInterval = '100 ms'
executor.exitReadTimeout = '10 sec'
trace {
    enabled = true
    file = 'submit-trace.tsv'
    overwrite = true
    fields = 'task_id,name,status,exit,attempt,cpus,memory'
}
