process.executor = 'local'
process.container = null
process.containerOptions = ''
docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
executor.cpus = 32
executor.memory = '128 GB'
trace {
    enabled = true
    file = 'smoke-trace.tsv'
    overwrite = true
    fields = 'task_id,name,status,exit,attempt,cpus,memory'
}

process {
 withLabel: sanger_caveman_scatter {
  container = null
  containerOptions = ''
 }
}

process { withLabel: sanger_pindel_scatter { container = null; containerOptions = '' } }

process { withLabel: sanger_split { container = null; containerOptions = '' } }
