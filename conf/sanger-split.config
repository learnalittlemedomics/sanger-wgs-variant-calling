// Sanger split workflow configuration.
// Example resource values; tune these for your data and compute environment.
// mem is in GB; split tasks retain the original 30 CPU : 108 GB ratio.
params {
    sanger_steps = [ascat: true, pindel: true, caveman: true, brass: true, qc: true]

    sanger_split_sif = ''

    sanger_resources = [
        // Light preparation, reference caching and packaging: 30/108 -> 5/18.
        prepare:   [cpus: 5,  mem: 18],
        cache_POP: [cpus: 5,  mem: 18],
        geno:      [cpus: 5,  mem: 18],
        assemble:  [cpus: 5,  mem: 18],

        // Moderate reductions, with ample headroom for other samples.
        ascat:       [cpus: 20, mem: 72],
        BRASS_input: [cpus: 15, mem: 54],
        verify_WT:   [cpus: 10, mem: 36],
        verify_MT:   [cpus: 10, mem: 36],

        // Retain original allocation: parallel coverage and variable SV workloads.
        BRASS_cover: [cpus: 30, mem: 108],
        BRASS:       [cpus: 30, mem: 108],

        // Not measured in this run: inherit original caller resources.
        CaVEMan_setup: [:],
        CaVEMan_split: [:],
        CaVEMan: [cpus: 30, mem: 108, threads: 12],
        CaVEMan_flag:  [:],
        CaVEMan_annot: [:],
        cgpPindel:       [:],
        cgpPindel_annot: [:]
    ]
}

singularity.autoMounts = true

process {
    withLabel: sanger_split {
        // No queue override: inherit external process.queue / scheduler default.
        time = '24h'
    }

    // Original 8 CPU / 24 GB -> 4 CPU / 12 GB (same 1:3 ratio).
    withName: 'SangerWgs:basT|SangerWgs:basN' {
        cpus = 4
        memory = '12 GB'
    }

    // Original 4 CPU / 16 GB -> 2 CPU / 8 GB (same 1:4 ratio).
    withName: 'SangerWgs:repack' {
        cpus = 2
        memory = '8 GB'
    }

    // Keep other small post-processing tasks at their existing allocations.
    // Exact name prevents the shared GATK prepQc selector from choosing its image.
    withName: 'SangerWgs:prepQc' {
        container = 'quay.io/icgc-argo/prep-sanger-qc:prep-sanger-qc.0.1.3.0'
    }
}


process {
    withName: 'SangerWgs:pAddIdT|SangerWgs:pAddIdN' {
        cache = 'deep'
    }
}
// Added by the CaVEMan scatter update.
includeConfig 'sanger-scatter.config'
