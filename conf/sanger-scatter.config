// Scatter target is a calibrated mean, not a scheduler wall-time limit.
params.sanger_scatter = [
    target_hours: 1.5,
    mstep_minutes_per_shard: 3.328,
    estep_minutes_per_shard: 15.83,
    workers_per_job: 12,
    worker_steps: [12,8,6,4],
    group_cpu_steps: [30,30,30,30],
    small_cpu_steps: [1,2,3,5],
    memory_gb_per_cpu: 3.6,
    max_retries: 3
]
// Example per-workflow submission limits; tune to your scheduler policy.
executor.queueSize = 50
executor.submitRateLimit = '50/10sec'

// Submission rejection retries are independent of process/OOM retries.
// Only explicit quota/admission rejections are retried here; do not retry ambiguous
// transport timeouts which might have occurred after a job was already accepted.
executor.retry.delay = '30 sec'
executor.retry.maxDelay = '5 min'
executor.retry.jitter = 0.25
executor.retry.maxAttempts = 300
// Nextflow <=25.04 reads submit.retry.reason; >=25.10 reads retry.reason.
// Set both to the same expression for compatibility with Nextflow 24.10.x.
executor.submit.retry.reason = '(?is).*(Job violates accounting/QOS policy|AssocMaxSubmitJobLimit|QOSMaxSubmitJobPerUserLimit|QOSMaxSubmitJobPerAccountLimit|QOSGrpSubmitJobsLimit|MaxSubmitJobs|job submit limit|job submission rate limit|temporarily unable to accept job).*'
executor.retry.reason = '(?is).*(Job violates accounting/QOS policy|AssocMaxSubmitJobLimit|QOSMaxSubmitJobPerUserLimit|QOSMaxSubmitJobPerAccountLimit|QOSGrpSubmitJobsLimit|MaxSubmitJobs|job submit limit|job submission rate limit|temporarily unable to accept job).*'


// Enable the required CaVEMan branches; retain the user's BRASS/QC switches.
params.sanger_steps = [*:(params.sanger_steps ?: [:]), ascat: true, pindel: true, caveman: true]
process {
    withLabel: sanger_caveman_scatter {
        time = '24h'
    }
}

process {
    withLabel: sanger_brass_scatter {
        time = '24h'
    }
}
