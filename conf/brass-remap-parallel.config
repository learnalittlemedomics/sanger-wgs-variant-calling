// Opt in with -c; do not include this globally for existing runs.
// Set to the absolute checkout/scripts/sanger-split/brass-remap-parallel path.
params.brass_remap_release_dir = null

process {
    withName: 'SangerWgs:sangerWgs:BRASS.*' {
        queue = 'long'
        time = '168h'
    }
    withName: 'SangerWgs:sangerWgs:BRASSPlan' {
        cpus = 30
        memory = '108 GB'
        containerOptions = {
            def release = params.brass_remap_release_dir
            if (!release || !release.toString().startsWith('/') || release.toString() =~ /[\s,:]/) {
                throw new IllegalArgumentException('brass_remap_release_dir must be an absolute path without whitespace, comma or colon')
            }
            return "--bind ${task.workDir}:/sanger --bind ${task.workDir}/split_scripts/get_abs_bkpts_from_clipped_reads.pl:/opt/wtsi-cgp/bin/get_abs_bkpts_from_clipped_reads.pl:ro --bind ${release}:/opt/wtsi-cgp/brass-remap-parallel:ro --bind ${release}/entry.pl:/opt/wtsi-cgp/bin/filter_with_microbes_and_remapping.pl:ro"
        }
    }
}
